-- The theme addon check (tools/next_theme_check): busted specs run on demand, outside spec/.
files["tools/next_theme_check/**/*.lua"] = {
	std = "+busted",
	globals = {
		"LoadBetterBagsModule",
		"ResetModuleStub",
		"FreshNextThemes",
	},
}

files["spec/**/*.lua"] = {
	globals = {
		"LoadBetterBagsModule",
		"StubBetterBagsModule",
		"ResetModuleStub",
		"LoadFreshBetterBagsModule",
		"UseSonataTextRoles",
		"FreshNextThemes",
		"UseNextTheme",
		"NextIconName",
		"MockData",
		"ResetMockMerchant",
		"ResetMockGuildBank",
		"MockSecret",
		"IsMockSecret",
		"SecretKeyGuard",
		"MockAtlases",
		"MockAtlas",
		"ResetMockAtlases",
		"UseNineSliceLayouts",
		"MockUnits",
	},
	ignore = {
		"212", -- unused argument (common in mock functions)
	},
}
